async function savePartsImport(entry) {
    const parts = entry.parts;
    const partNumbers = parts.map(part => part.part_number);
        const { data: existingParts, error: existingError } = await supabaseClient
            .from("parts_catalog")
            .select("part_number, part_name")
            .in("part_number", partNumbers);

        if (existingError) throw existingError;

        const existingMap = new Map(
            (existingParts || []).map(part => [normalizeImportedPartNumber(part.part_number), part])
        );

        const newParts = [];
        const placeholderUpdates = [];
        let keptExisting = 0;

        for (const part of parts) {
            const existing = existingMap.get(part.part_number);

            if (!existing) {
                newParts.push({
                    part_number: part.part_number,
                    manufacturer: "Not entered",
                    part_name: part.part_name
                });
                continue;
            }

            const currentName = String(existing.part_name || "").trim();
            const nameNeedsUpdate = !currentName || currentName.toLowerCase() === "not entered";

            if (nameNeedsUpdate) {
                placeholderUpdates.push({
                    part_number: existing.part_number,
                    part_name: part.part_name
                });
            } else {
                keptExisting++;
            }
        }

        if (newParts.length) {
            const { error: insertError } = await supabaseClient
                .from("parts_catalog")
                .insert(newParts);
            if (insertError) throw insertError;
        }

        for (const update of placeholderUpdates) {
            const { error: updateError } = await supabaseClient
                .from("parts_catalog")
                .update({
                    part_name: update.part_name
                })
                .eq("part_number", update.part_number);
            if (updateError) throw updateError;
        }

        const { error: historyError } = await supabaseClient
            .from("parts_import_history")
            .insert({
                ro_number: entry.ro_number,
                part_count: parts.length,
                total_pieces: entry.total_pieces,
                file_name: entry.file_name,
                parts: parts.map(part => ({
                    part_number: part.part_number,
                    part_name: part.part_name,
                    quantity: Number(part.quantity || 0)
                }))
            });
        if (historyError) throw historyError;


    return newParts.length + " new, " + placeholderUpdates.length + " filled in, " + keptExisting + " already in catalog. Expected list saved.";
}

