function normalizeVerificationPartNumber(value) {
    return String(value || "")
        .trim()
        .toUpperCase()
        .replace(/[^A-Z0-9]/g, "");
}

function getVerificationStatus(expectedQty, scannedQty) {
    const expected = Number(expectedQty || 0);
    const scanned = Number(scannedQty || 0);

    if (expected <= 0 && scanned > 0) return "extra";
    if (scanned <= 0) return "missing";
    if (scanned < expected) return "partial";
    if (scanned > expected) return "over";
    return "verified";
}

function verificationBadge(status) {
    const labels = {
        verified: "✓ VERIFIED",
        missing: "MISSING",
        partial: "PARTIAL",
        extra: "EXTRA PART",
        over: "EXTRA QTY"
    };
    return `<span class="verify-badge ${status}">${labels[status] || status}</span>`;
}

async function getVerificationRONumbers(roNumber) {
    const cleanRO = String(roNumber || "").trim();
    if (!cleanRO) return [];

    const { data, error } = await supabaseClient
        .from("repair_orders")
        .select("ro_number, job_group")
        .eq("ro_number", cleanRO)
        .maybeSingle();

    if (error) {
        console.error("Could not load RO group for verification:", error);
        return [cleanRO];
    }

    if (!data) return [cleanRO];
    const group = getROGroupNumbers(data.job_group, data.ro_number);
    return group.length ? group : [cleanRO];
}

function buildPartsVerification(expectedParts, receivedParts, catalogMap = new Map()) {
    const expectedMap = new Map();
    const receivedMap = new Map();

    for (const part of expectedParts || []) {
        const key = normalizeVerificationPartNumber(part.part_number);
        if (!key) continue;
        const existing = expectedMap.get(key) || {
            key,
            part_number: String(part.part_number || "").trim(),
            part_name: String(part.part_name || "Not entered").trim() || "Not entered",
            expected: 0
        };
        existing.expected += Number(part.quantity || 0);
        if ((!existing.part_name || existing.part_name === "Not entered") && part.part_name) {
            existing.part_name = String(part.part_name).trim();
        }
        expectedMap.set(key, existing);
    }

    for (const part of receivedParts || []) {
        const key = normalizeVerificationPartNumber(part.part_number);
        if (!key) continue;
        const existing = receivedMap.get(key) || {
            key,
            part_number: String(part.part_number || "").trim(),
            scanned: 0,
            locations: new Set()
        };
        existing.scanned += Number(part.quantity || 0);
        const location = String(part.location || "").trim();
        if (location) existing.locations.add(location);
        receivedMap.set(key, existing);
    }

    const keys = [...new Set([...expectedMap.keys(), ...receivedMap.keys()])];
    const rows = keys.map(key => {
        const expected = expectedMap.get(key);
        const received = receivedMap.get(key);
        const catalogPart = [...catalogMap.values()].find(item =>
            normalizeVerificationPartNumber(item.part_number) === key
        );
        const expectedQty = Number(expected?.expected || 0);
        const scannedQty = Number(received?.scanned || 0);
        const status = getVerificationStatus(expectedQty, scannedQty);

        return {
            key,
            part_number: expected?.part_number || received?.part_number || key,
            part_name: expected?.part_name || catalogPart?.part_name || "Unknown part",
            expected: expectedQty,
            scanned: scannedQty,
            status,
            locations: received ? [...received.locations] : []
        };
    });

    const order = { missing: 0, partial: 1, over: 2, extra: 3, verified: 4 };
    rows.sort((a, b) => (order[a.status] ?? 9) - (order[b.status] ?? 9) || a.part_number.localeCompare(b.part_number));

    const expectedPieces = rows.reduce((sum, row) => sum + row.expected, 0);
    const verifiedPieces = rows.reduce((sum, row) => sum + Math.min(row.expected, row.scanned), 0);
    const missingPieces = rows.reduce((sum, row) => sum + Math.max(row.expected - row.scanned, 0), 0);
    const extraPieces = rows.reduce((sum, row) => sum + Math.max(row.scanned - row.expected, 0), 0);

    return {
        rows,
        expectedPieces,
        verifiedPieces,
        missingPieces,
        extraPieces,
        complete: expectedPieces > 0 && missingPieces === 0
    };
}

let receiveChecklistVersion = 0;
let receiveChecklistTimer = null;
let receiveChecklistState = null;
let receiveManualBusy = false;

function scheduleReceiveChecklist() {
    clearReceiveChecklist();
    receiveChecklistTimer = setTimeout(() => loadReceiveChecklist(), 350);
}

function clearReceiveChecklist() {
    clearTimeout(receiveChecklistTimer);
    receiveChecklistVersion++;
    receiveChecklistState = null;
    document.getElementById("receiveChecklistStatus").textContent = "Enter an RO to view its expected parts.";
    document.getElementById("receiveChecklistSummary").style.display = "none";
    document.getElementById("receiveChecklistResults").style.display = "none";
    document.getElementById("receiveChecklistTable").innerHTML = "";
    document.getElementById("receiveChecklistFeedback").textContent = "";
    document.getElementById("receiveChecklistManualStatus").textContent = "";
}

async function receiveExpectedListKey(importRow) {
    // Version checks are scoped to the exact import; re-imports start unchecked.
    const bytes = new TextEncoder().encode(JSON.stringify([importRow.imported_at, importRow.file_name, importRow.parts]));
    const digest = await crypto.subtle.digest("SHA-256", bytes);
    return Array.from(new Uint8Array(digest), n => n.toString(16).padStart(2, "0")).join("");
}

function renderReceiveChecklist(lastPartNumber = "") {
    const state = receiveChecklistState;
    if (!state) return;
    const v = state.verification;
    const manuallyChecked = v.rows.reduce((sum, row) => sum + (state.manualKeys.has(row.key) ? Math.max(row.expected-row.scanned, 0) : 0), 0);
    const summary = document.getElementById("receiveChecklistSummary");
    summary.style.display = "block";
    summary.className = "verification-banner " + (v.complete ? "complete" : "incomplete");
    summary.textContent = v.verifiedPieces + " / " + v.expectedPieces + " verified • " + v.missingPieces + " not yet received" + (manuallyChecked ? " • " + manuallyChecked + " manually checked" : "") + (v.extraPieces ? " • " + v.extraPieces + " extra" : "");
    const key = normalizeVerificationPartNumber(lastPartNumber);
    document.getElementById("receiveChecklistTable").innerHTML = v.rows.map((row, index) => {
        const checked = state.manualKeys.has(row.key);
        const locations = row.locations.length ? '<div class="verification-location">Location: ' + escapeHtml(row.locations.join(", ")) + '</div>' : "";
        const manual = checked ? '<span class="manual-badge">MANUALLY CHECKED — seen here, not barcode verified</span>' : "";
        const receiveAction = row.expected > row.scanned ? '<button type="button" class="primary" onclick="receiveExpectedPart(' + index + ')"' + (receiveBusy ? ' disabled' : '') + '>RECEIVE</button> ' : "";
        const action = row.expected > row.scanned && state.manualAvailable ? '<button type="button" class="secondary" onclick="markReceiveExpectedPart(' + index + ')"' + (receiveManualBusy ? ' disabled' : '') + '>' + (checked ? 'UNDO MANUAL CHECK' : 'MARK HERE') + '</button>' : "";
        return '<tr' + (key && row.key === key ? ' class="just-scanned"' : '') + '><td data-label="Part Number">' + escapeHtml(row.part_number) + '</td><td data-label="Description">' + escapeHtml(row.part_name) + locations + '</td><td data-label="Expected">' + row.expected + '</td><td data-label="Received">' + row.scanned + '</td><td data-label="Status">' + verificationBadge(row.status) + manual + receiveAction + action + '</td></tr>';
    }).join("");
    document.getElementById("receiveChecklistResults").style.display = "block";
    if (key) {
        const row = v.rows.find(row => row.key === key);
        document.getElementById("receiveChecklistFeedback").textContent = row ? row.part_number + " — " + (row.status === "extra" ? "EXTRA PART — not on expected list" : row.status === "over" ? "EXTRA QTY" : row.status.toUpperCase()) + " — received " + row.scanned + " / " + row.expected : "Part received.";
    }
}

async function loadReceiveChecklist(lastPartNumber = "") {
    const roNumber = document.getElementById("roNumber").value.trim();
    clearReceiveChecklist();
    if (!roNumber || !isAdmin) return;
    const version = receiveChecklistVersion;
    const current = () => version === receiveChecklistVersion && isAdmin && document.getElementById("roNumber").value.trim() === roNumber;
    const status = document.getElementById("receiveChecklistStatus");
    status.textContent = "Loading expected parts for RO " + roNumber + "...";
    try {
        const { data: importRow, error: importError } = await supabaseClient.from("parts_import_history")
            .select("parts, file_name, imported_at").eq("ro_number", roNumber)
            .order("imported_at", { ascending: false }).limit(1).maybeSingle();
        if (importError) throw importError;
        if (!current()) return;
        if (!importRow || !Array.isArray(importRow.parts) || !importRow.parts.length) {
            status.textContent = "RO " + roNumber + " has no saved expected parts list. Import its Auto/Mate Part Preview PDF. You can still receive parts.";
            return;
        }
        const [roNumbers, listKey] = await Promise.all([getVerificationRONumbers(roNumber), receiveExpectedListKey(importRow)]);
        const [physical, manual] = await Promise.all([
            supabaseClient.from("parts").select("ro_number, part_number, quantity, location, received_at").in("ro_number", roNumbers.length ? roNumbers : [roNumber]),
            supabaseClient.from("parts_manual_checks").select("part_key").eq("ro_number", roNumber).eq("list_key", listKey)
        ]);
        if (physical.error) throw physical.error;
        if (!current()) return;
        // Catalog enrichment must never delay the expected checklist or block receipts.
        receiveChecklistState = {roNumber, listKey, version, manualAvailable: !manual.error,
            manualKeys: new Set((manual.data || []).map(row => row.part_key)),
            verification: buildPartsVerification(importRow.parts, physical.data || [])};
        status.textContent = "RO " + roNumber + " — " + (importRow.file_name || "Latest Auto/Mate list") + (roNumbers.length > 1 ? " • Scans from paired ROs " + roNumbers.join(" / ") : "") + (importRow.imported_at ? " • " + new Date(importRow.imported_at).toLocaleString() : "");
        document.getElementById("receiveChecklistManualStatus").textContent = manual.error ? "Manual checks unavailable. Apply the supplied SQL migration and check admin access. Receiving still works." : "MARK HERE confirms the remaining quantity was physically seen. It does not add received inventory.";
        renderReceiveChecklist(lastPartNumber);
        try {
            const catalog = await fetchCatalogMap((physical.data || []).map(row => row.part_number));
            if (current() && receiveChecklistState?.version === version) {
                receiveChecklistState.verification = buildPartsVerification(importRow.parts, physical.data || [], catalog);
                renderReceiveChecklist(lastPartNumber);
            }
        } catch (catalogError) { console.error("Checklist catalog enrichment failed:", catalogError); }
    } catch (error) {
        console.error("Receive checklist failed:", error);
        if (current()) status.textContent = "Could not load the parts checklist. Receiving still works. Use Refresh List to retry.";
    }
}

async function markReceiveExpectedPart(index) {
    const state = receiveChecklistState;
    const row = state?.verification.rows[index];
    if (!isAdmin || !state?.manualAvailable || !row || row.expected <= row.scanned || receiveManualBusy) return;
    const checked = state.manualKeys.has(row.key);
    receiveManualBusy = true;
    renderReceiveChecklist();
    try {
        // Re-read latest import before saving so a newly imported list cannot inherit old checks.
        const {data: latest, error: latestError} = await supabaseClient.from("parts_import_history")
            .select("parts, file_name, imported_at").eq("ro_number", state.roNumber)
            .order("imported_at", {ascending:false}).limit(1).maybeSingle();
        if (latestError) throw latestError;
        if (receiveChecklistState !== state) return;
        if (!latest || await receiveExpectedListKey(latest) !== state.listKey) {
            await loadReceiveChecklist();
            return;
        }
        let result;
        if (checked) {
            result = await supabaseClient.from("parts_manual_checks").delete()
                .eq("ro_number", state.roNumber).eq("list_key", state.listKey).eq("part_key", row.key);
        } else {
            result = await supabaseClient.from("parts_manual_checks").upsert({
                ro_number: state.roNumber, list_key: state.listKey, part_key: row.key,
                checked_at: new Date().toISOString()
            }, {onConflict:"ro_number,list_key,part_key"});
        }
        if (result.error) throw result.error;
        if (receiveChecklistState === state) {
            if (checked) state.manualKeys.delete(row.key); else state.manualKeys.add(row.key);
            document.getElementById("receiveChecklistManualStatus").textContent = checked ? "Manual check removed." : row.part_number + " MANUALLY CHECKED. Scanned quantities are unchanged.";
        }
    } catch (error) {
        console.error("Manual check failed:", error);
        if (receiveChecklistState === state) document.getElementById("receiveChecklistManualStatus").textContent = "Manual check was not saved. Please retry. " + (error.message || "");
    } finally {
        receiveManualBusy = false;
        renderReceiveChecklist();
    }
}

function renderPartsVerification(roNumber, verification, importDate = "") {
    const results = document.getElementById("partsListSearchResults");
    const tbody = document.getElementById("partsListSearchTable");
    const summary = document.getElementById("partsVerificationSummary");
    const banner = document.getElementById("partsVerificationBanner");

    if (!results || !tbody || !summary || !banner) return;

    document.getElementById("verificationExpected").textContent = verification.expectedPieces;
    document.getElementById("verificationVerified").textContent = verification.verifiedPieces;
    document.getElementById("verificationMissing").textContent = verification.missingPieces;
    document.getElementById("verificationExtras").textContent = verification.extraPieces;

    banner.className = "verification-banner " + (verification.complete ? "complete" : "incomplete");
    if (verification.complete) {
        banner.textContent = `RO ${roNumber} — PARTS COMPLETE: all ${verification.expectedPieces} expected piece${verification.expectedPieces === 1 ? " is" : "s are"} physically verified.`;
    } else {
        banner.textContent = `RO ${roNumber} — ${verification.missingPieces} expected piece${verification.missingPieces === 1 ? " is" : "s are"} still not physically verified.`;
    }

    tbody.innerHTML = verification.rows.map(row => {
        const locationLine = row.locations.length
            ? `<div class="verification-location">Location: ${escapeHtml(row.locations.join(", "))}</div>`
            : "";
        return `<tr>
            <td><strong>${escapeHtml(row.part_number)}</strong>${locationLine}</td>
            <td>${escapeHtml(row.part_name || "Unknown part")}</td>
            <td>${escapeHtml(row.expected)}</td>
            <td>${escapeHtml(row.scanned)}</td>
            <td>${verificationBadge(row.status)}</td>
        </tr>`;
    }).join("");

    summary.style.display = "block";
    results.style.display = "block";

    const importText = importDate ? ` Latest expected list imported ${importDate}.` : "";
    setPartsListSearchStatus(
        `Compared Auto/Mate's expected list with the parts physically scanned into this app.${importText}`,
        verification.complete ? "success" : ""
    );
}

async function openImportedPartsList(roNumber) {
    const input = document.getElementById("partsListROSearch");
    if (input) input.value = String(roNumber || "");
    await searchImportedPartsList();
}

async function searchImportedPartsList() {
    if (!requireAdmin()) return;

    const input = document.getElementById("partsListROSearch");
    const results = document.getElementById("partsListSearchResults");
    const tbody = document.getElementById("partsListSearchTable");
    const summary = document.getElementById("partsVerificationSummary");
    const roNumber = String(input?.value || "").trim();

    if (results) results.style.display = "none";
    if (summary) summary.style.display = "none";
    if (tbody) tbody.innerHTML = "";

    if (!roNumber) {
        setPartsListSearchStatus("Enter a repair order number.", "error");
        return;
    }

    setPartsListSearchStatus(`Checking expected vs physically scanned parts for RO ${roNumber}...`);

    try {
        const { data: importRow, error: importError } = await supabaseClient
            .from("parts_import_history")
            .select("ro_number, part_count, total_pieces, file_name, parts, imported_at")
            .eq("ro_number", roNumber)
            .order("imported_at", { ascending: false })
            .limit(1)
            .maybeSingle();

        if (importError) throw importError;

        if (!importRow) {
            setPartsListSearchStatus(`No Auto/Mate expected parts list was found for RO ${roNumber}. Import that RO's Part Preview PDF first.`, "error");
            return;
        }

        const expectedParts = Array.isArray(importRow.parts) ? importRow.parts : [];
        if (!expectedParts.length) {
            setPartsListSearchStatus(`RO ${roNumber} was imported before searchable expected parts lists were added. Re-import that RO's Part Preview PDF once.`, "error");
            return;
        }

        const roNumbers = await getVerificationRONumbers(roNumber);
        const { data: receivedRows, error: receivedError } = await supabaseClient
            .from("parts")
            .select("ro_number, part_number, quantity, location, received_at")
            .in("ro_number", roNumbers.length ? roNumbers : [roNumber]);
        if (receivedError) throw receivedError;

        const catalogMap = await fetchCatalogMap((receivedRows || []).map(row => row.part_number));
        const verification = buildPartsVerification(expectedParts, receivedRows || [], catalogMap);
        const when = importRow.imported_at ? new Date(importRow.imported_at).toLocaleString() : "";

        renderPartsVerification(roNumber, verification, when);
    } catch (error) {
        console.error("Parts verification failed:", error);
        const message = String(error?.message || "Unknown error.");
        if (/parts_import_history|parts|total_pieces|schema cache/i.test(message)) {
            setPartsListSearchStatus("Parts Verification setup is not finished. Run the V1.4.3 searchable-parts-list SQL once, then refresh the app.", "error");
            return;
        }
        setPartsListSearchStatus("Could not verify this RO: " + message, "error");
    }
}

