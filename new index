function parseAutoMateROListLine(line) {
    const text = String(line || "").replace(/\s+/g, " ").trim();
    const roMatch = text.match(/^(\d+)\s+/);
    if (!roMatch) return null;
    const statusMatch = text.match(/\b(Open|Invoiced|Void)\b/i);
    if (!statusMatch) return null;
    return {
        ro_number: roMatch[1],
        status: statusMatch[1].toLowerCase(),
        vehicle_year: "",
        vehicle_make: "",
        vehicle_model: ""
    };
}

function normalizePdfItem(item) {
    return {
        text: String(item?.str || "").replace(/\s+/g, " ").trim(),
        x: Number(item?.transform?.[4] || 0),
        y: Number(item?.transform?.[5] || 0)
    };
}

function extractAutoMateRORowsFromPage(items) {
    const parsed = new Map();
    const usable = (items || []).filter(item => item.text);

    // Keep the simple full-line fallback for PDFs where Auto/Mate exposes an
    // entire printed row as one text item. The coordinate parser below will
    // overwrite these entries with vehicle information when the table columns
    // are available.
    for (const item of usable) {
        const direct = parseAutoMateROListLine(item.text);
        if (direct) parsed.set(direct.ro_number, direct);
    }

    const findHeader = label => usable.find(item =>
        item.text.toLowerCase() === String(label).toLowerCase()
    );

    const roHeader = findHeader("RO#");
    const statusHeader = findHeader("Status");
    const yearHeader = findHeader("Yr");
    const makeHeader = findHeader("Make");
    const modelHeader = findHeader("Model");
    const plateHeader = findHeader("Plate");

    if (roHeader && statusHeader) {
        // Auto/Mate generates this report internally rotated. Detect whether
        // table columns run along PDF Y instead of PDF X, then use one generic
        // row/column system for either orientation.
        const headersShareX =
            Math.abs(roHeader.x - statusHeader.x) <
            Math.abs(roHeader.y - statusHeader.y);

        const rowCoord = item => headersShareX ? item.x : item.y;
        const columnCoord = item => headersShareX ? item.y : item.x;
        const roColumn = columnCoord(roHeader);

        // Build exact bands for the vehicle columns from the printed headers.
        // The midpoint between neighboring headers keeps Make/Model text from
        // leaking into Year, Plate, Stock#, or Advisor fields.
        const vehicleHeaders = [
            ["status", statusHeader],
            ["year", yearHeader],
            ["make", makeHeader],
            ["model", modelHeader],
            ["plate", plateHeader]
        ].filter(([, header]) => header);

        const sortedColumns = vehicleHeaders
            .map(([name, header]) => ({ name, pos: columnCoord(header) }))
            .sort((a, b) => a.pos - b.pos);

        const bands = new Map();
        sortedColumns.forEach((column, index) => {
            const previous = sortedColumns[index - 1];
            const next = sortedColumns[index + 1];
            const low = previous ? (previous.pos + column.pos) / 2 : -Infinity;
            const high = next ? (column.pos + next.pos) / 2 : Infinity;
            bands.set(column.name, { low, high });
        });

        const readField = (rowItems, field) => {
            const band = bands.get(field);
            if (!band) return "";
            const values = rowItems
                .filter(item => {
                    const coord = columnCoord(item);
                    return coord >= band.low && coord < band.high;
                })
                .sort((a, b) => headersShareX
                    ? columnCoord(b) - columnCoord(a)
                    : columnCoord(a) - columnCoord(b))
                .map(item => item.text)
                .filter(Boolean);
            return values.join(" ").replace(/\s+/g, " ").trim();
        };

        const statusItems = usable.filter(item =>
            /^(Open|Invoiced|Void)$/i.test(item.text)
        );

        for (const statusItem of statusItems) {
            const status = statusItem.text.toLowerCase();
            const statusRow = rowCoord(statusItem);
            const rowItems = usable.filter(item =>
                Math.abs(rowCoord(item) - statusRow) <= 5
            );

            const candidates = rowItems
                .filter(item =>
                    item !== statusItem &&
                    /^\d+$/.test(item.text)
                )
                .sort((a, b) =>
                    Math.abs(columnCoord(a) - roColumn) -
                    Math.abs(columnCoord(b) - roColumn)
                );

            if (!candidates.length) continue;

            const roNumber = candidates[0].text;
            let vehicleYear = readField(rowItems, "year");
            const vehicleMake = readField(rowItems, "make");
            const vehicleModel = readField(rowItems, "model");

            // Year should only be a four-digit vehicle model year. If another
            // number ever falls into that band, don't show bad information.
            if (!/^(19|20)\d{2}$/.test(vehicleYear)) vehicleYear = "";

            parsed.set(roNumber, {
                ro_number: roNumber,
                status,
                vehicle_year: vehicleYear,
                vehicle_make: vehicleMake,
                vehicle_model: vehicleModel
            });
        }
    }

    return Array.from(parsed.values());
}
async function previewROListPdf(file) {
    if (!requireAdmin()) { clearROListSync(); return; }

    previewedROList = null;
    const button = document.getElementById("syncROListButton");
    if (button) button.disabled = true;

    if (!file) {
        setROSyncPreview("Choose an Auto/Mate Repair Order List PDF.", "error");
        return;
    }
    if (!file.name.toLowerCase().endsWith(".pdf")) {
        setROSyncPreview("Please choose a PDF file.", "error");
        return;
    }
    if (!window.pdfjsLib) {
        setROSyncPreview("The PDF reader did not load. Check the internet connection and reload the app.", "error");
        return;
    }

    setROSyncPreview("Reading every page of the Auto/Mate Repair Order List...");

    try {
        pdfjsLib.GlobalWorkerOptions.workerSrc =
            "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

        const bytes = new Uint8Array(await file.arrayBuffer());
        const pdf = await pdfjsLib.getDocument({ data: bytes }).promise;

        const roMap = new Map();
        let recognizedReport = false;
        let reportedTotal = null;

        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
            const page = await pdf.getPage(pageNumber);
            const textContent = await page.getTextContent();
            const items = (textContent.items || [])
                .map(normalizePdfItem)
                .filter(item => item.text);

            const pageText = items
                .map(item => item.text)
                .join(" ")
                .replace(/\s+/g, " ");

            if (/Repair\s+Order\s+List/i.test(pageText)) {
                recognizedReport = true;
            }

            const totalMatch = pageText.match(
                /TOTAL\s+NUMBER\s+OF\s+REPAIR\s+ORDERS\s*=\s*(\d+)/i
            );
            if (totalMatch) {
                reportedTotal = Number(totalMatch[1]);
            }

            const pageRows = extractAutoMateRORowsFromPage(items);
            for (const row of pageRows) {
                roMap.set(row.ro_number, row);
            }
        }

        if (!recognizedReport) {
            setROSyncPreview(
                "This does not look like the Auto/Mate Repair Order List report.",
                "error"
            );
            return;
        }

        const rows = Array.from(roMap.values());

        if (!rows.length) {
            setROSyncPreview(
                "I found the Repair Order List header but could not read any RO rows.",
                "error"
            );
            return;
        }

        if (reportedTotal !== null && rows.length !== reportedTotal) {
            setROSyncPreview(
                `Stopped for safety: Auto/Mate says this report has ${reportedTotal} ROs, but the app read ${rows.length}. Nothing was updated.`,
                "error"
            );
            return;
        }

        const open = rows.filter(row => row.status === "open");
        const inactive = rows.length - open.length;

        const withVehicleInfo = rows.filter(row =>
            row.vehicle_year || row.vehicle_make || row.vehicle_model
        ).length;

        previewedROList = {
            rows,
            open_ros: open.map(row => row.ro_number),
            file_name: file.name,
            page_count: pdf.numPages,
            reported_total: reportedTotal
        };

        setROSyncPreview(
            `Found ${rows.length} ROs across ${pdf.numPages} pages: ${open.length} Open and ${inactive} Invoiced/Void. Vehicle info read for ${withVehicleInfo}. Ready to update the app.`,
            "success"
        );
        if (button) button.disabled = false;
    } catch (error) {
        console.error("RO list PDF read failed:", error);
        setROSyncPreview(
            "Could not read this PDF. " + (error?.message || "Unknown PDF error."),
            "error"
        );
    }
}

async function syncPreviewedROList() {
    if (!requireAdmin()) return;
    if (!previewedROList || !previewedROList.rows.length) {
        setROSyncPreview("Choose and preview the current Repair Order List first.", "error");
        return;
    }
    if (!confirm(`Update active ROs from this Auto/Mate report?\n\n${previewedROList.open_ros.length} Open ROs will be treated as active.`)) return;

    const button = document.getElementById("syncROListButton");
    if (button) button.disabled = true;
    setROSyncPreview("Updating active ROs from Auto/Mate...");

    try {
        const now = new Date().toISOString();
        const rows = previewedROList.rows;

        // One read for the entire table instead of one lookup per RO.
        const { data: existingRows, error: existingError } = await supabaseClient
            .from("repair_orders")
            .select("ro_number, technician, active, source, job_group, automate_active");
        if (existingError) throw existingError;

        const existingMap = new Map(
            (existingRows || []).map(row => [String(row.ro_number), row])
        );
        const reportNumbers = new Set(rows.map(row => String(row.ro_number)));

        let assignedOpen = 0;
        let unassignedOpen = 0;
        const upserts = [];

        for (const row of rows) {
            const roNumber = String(row.ro_number);
            const isOpen = row.status === "open";
            const existing = existingMap.get(roNumber);

            const vehicleState = {
                automate_active: isOpen,
                automate_last_seen_at: now,
                vehicle_year: row.vehicle_year || null,
                vehicle_make: row.vehicle_make || null,
                vehicle_model: row.vehicle_model || null
            };

            if (!existing) {
                if (!isOpen) continue;

                upserts.push({
                    ro_number: roNumber,
                    technician: "Unassigned",
                    job_group: roNumber,
                    source: "automate_unassigned",
                    active: true,
                    ...vehicleState
                });
                unassignedOpen++;
                continue;
            }

            const base = {
                ro_number: roNumber,
                technician: existing.technician || "Unassigned",
                job_group: existing.job_group || roNumber,
                source: existing.source || "manual",
                active: existing.active !== false
            };

            if (!isOpen) {
                upserts.push({ ...base, ...vehicleState });
                continue;
            }

            const hasCurrentTech =
                existing.active === true &&
                existing.technician &&
                existing.technician !== "Unassigned";

            if (hasCurrentTech) {
                upserts.push({ ...base, ...vehicleState });
                assignedOpen++;
            } else {
                upserts.push({
                    ...base,
                    ...vehicleState,
                    technician: "Unassigned",
                    source: "automate_unassigned",
                    active: true,
                    // Preserve the Google job_group if one already exists so
                    // paired ROs stay paired even when one side becomes unassigned.
                    job_group: existing.job_group || roNumber
                });
                unassignedOpen++;
            }
        }

        // Apply report rows in batches. This happens BEFORE stale ROs are
        // deactivated, so a failed upload cannot blank the active list first.
        for (let i = 0; i < upserts.length; i += 100) {
            const batch = upserts.slice(i, i + 100);
            const { error } = await supabaseClient
                .from("repair_orders")
                .upsert(batch, { onConflict: "ro_number" });
            if (error) throw error;
        }

        // Only after the report rows succeeded, turn off ROs absent from the
        // newest Auto/Mate report.
        const staleNumbers = (existingRows || [])
            .filter(row => row.automate_active === true && !reportNumbers.has(String(row.ro_number)))
            .map(row => String(row.ro_number));

        for (let i = 0; i < staleNumbers.length; i += 100) {
            const chunk = staleNumbers.slice(i, i + 100);
            const { error } = await supabaseClient
                .from("repair_orders")
                .update({ automate_active: false })
                .in("ro_number", chunk);
            if (error) throw error;
        }

        setROSyncPreview(
            `RO sync complete: ${assignedOpen} Open RO${assignedOpen === 1 ? "" : "s"} assigned.` +
            ` ${unassignedOpen} Open RO${unassignedOpen === 1 ? " has" : "s have"} no current tech.` +
            ` ${staleNumbers.length} old RO${staleNumbers.length === 1 ? "" : "s"} removed from the active list.`,
            "success"
        );

        await Promise.all([loadROAssignments(), loadUnassignedROs()]);
    } catch (error) {
        console.error("RO sync failed:", error);
        setROSyncPreview("RO sync failed: " + (error.message || "Unknown error."), "error");
        if (button) button.disabled = false;
    }
}

