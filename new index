async function savePart() {
    if (!requireAdmin()) return;

    const partNumber = document.getElementById("catalogPartNumber").value.trim();
    const partName = document.getElementById("partName").value.trim();

    if (!partNumber) {
        showStatus("Please enter a part number.", "error");
        return;
    }

    if (!partName) {
        showStatus("Please enter the part name or description.", "error");
        return;
    }

    if (editingPartNumber) {
        const { error } = await supabaseClient
            .from("parts_catalog")
            .update({ part_number: partNumber, part_name: partName })
            .eq("part_number", editingPartNumber);

        if (error) {
            console.error(error);
            showStatus("Could not update part: " + error.message, "error");
            return;
        }
    } else {
        const { error } = await supabaseClient
            .from("parts_catalog")
            .insert([{
                part_number: partNumber,
                manufacturer: "Not entered",
                part_name: partName
            }]);

        if (error) {
            console.error(error);
            showStatus("Could not add part: " + error.message, "error");
            return;
        }
    }

    showStatus("", "");
    clearCatalogForm();
    invalidateCatalogCache();
    await loadCatalog(true);
}

/* =========================================================
   LOAD CATALOG
========================================================= */

async function loadCatalog(force = false) {
    if (!force && catalogCache) {
        renderCatalog(catalogCache);
        return;
    }

    if (!force && catalogLoadPromise) {
        await catalogLoadPromise;
        if (catalogCache) renderCatalog(catalogCache);
        return;
    }

    catalogLoadPromise = (async () => {
        const { data, error } = await supabaseClient
            .from("parts_catalog")
            .select("part_number, part_name")
            .order("part_number", { ascending: true });

        if (error) throw error;
        catalogCache = data || [];
    })();

    try {
        await catalogLoadPromise;
        renderCatalog(catalogCache || []);
    } catch (error) {
        console.error(error);
        document.getElementById("catalogTable").innerHTML =
            `<tr><td colspan="3" class="empty">Error loading catalog.</td></tr>`;
        document.getElementById("catalogCount").textContent = "Error loading catalog.";
    } finally {
        catalogLoadPromise = null;
    }
}

function renderCatalog(allParts) {
    const search = document.getElementById("searchInput").value.trim().toLowerCase();
    const table = document.getElementById("catalogTable");

    let parts = allParts || [];
    if (search) {
        const normalizedSearch = normalizeReceivedPartKey(search);
        parts = parts.filter(part =>
            String(part.part_number || "").toLowerCase().includes(search) ||
            (normalizedSearch && normalizeReceivedPartKey(part.part_number).includes(normalizedSearch)) ||
            String(part.part_name || "").toLowerCase().includes(search)
        );
    }

    document.getElementById("catalogCount").textContent =
        `${parts.length} part${parts.length === 1 ? "" : "s"} found`;

    if (!parts.length) {
        table.innerHTML = `<tr><td colspan="3" class="empty">No parts found.</td></tr>`;
        return;
    }

    table.innerHTML = parts.map(part => `
        <tr>
            <td>${escapeHtml(part.part_number)}</td>
            <td>${escapeHtml(part.part_name)}</td>
            <td>
                ${isAdmin ? `
                <div class="actions">
                    <button class="secondary" onclick="editPart('${escapeJs(part.part_number)}')">EDIT</button>
                    <button class="danger" onclick="deletePart('${escapeJs(part.part_number)}')">DELETE</button>
                </div>
                ` : `<span style="color:#6b7280;">View only</span>`}
            </td>
        </tr>
    `).join("");
}

