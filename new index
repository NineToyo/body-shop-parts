function normalizeImportedPartNumber(value) {
    return String(value || "").trim().toUpperCase().replace(/\s+/g, "");
}

function parseAutoMateTextLine(line) {
    // Auto/Mate Part Preview rows look like:
    // A 52119AK901 COVER, FR BUMP C 1 $147.99 $225.37 $225.37
    const match = String(line || "").match(
        /^\s*[A-Z]\s+([A-Z0-9-]{3,})\s+(.+?)\s+[A-Z]\s+(\d+)\s+\$[\d,.]+(?:\s+\$[\d,.]+){1,2}/i
    );

    if (!match) return null;

    const partNumber = normalizeImportedPartNumber(match[1]);
    const description = String(match[2] || "").replace(/\s+/g, " ").trim();
    const quantity = Number(match[3]);

    if (!partNumber || !description || !Number.isFinite(quantity) || quantity < 1) {
        return null;
    }

    return {
        part_number: partNumber,
        part_name: description,
        quantity: quantity
    };
}

function groupPdfItemsIntoLines(items) {
    const rows = [];

    for (const item of items || []) {
        const text = String(item.str || "").trim();
        if (!text) continue;

        const x = item.transform?.[4] || 0;
        const y = item.transform?.[5] || 0;
        let row = rows.find(existing => Math.abs(existing.y - y) <= 2);

        if (!row) {
            row = { y, items: [] };
            rows.push(row);
        }

        row.items.push({ x, text });
    }

    rows.sort((a, b) => b.y - a.y);

    return rows.map(row =>
        row.items
            .sort((a, b) => a.x - b.x)
            .map(item => item.text)
            .join(" ")
            .replace(/\s+/g, " ")
            .trim()
    );
}


async function parsePartsListPdf(file) {
    if (!/\.pdf$/i.test(file.name)) throw new Error("Please choose a PDF file.");
    if (!window.pdfjsLib) throw new Error("The PDF reader did not load. Check the internet connection and reload the app.");
    pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
    const bytes = new Uint8Array(await file.arrayBuffer());
    const loadingTask = pdfjsLib.getDocument({ data: bytes });
    try {
        const pdf = await loadingTask.promise;
        let roNumber = "";
        const importedMap = new Map();

        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
            const page = await pdf.getPage(pageNumber);
            const textContent = await page.getTextContent();
            const lines = groupPdfItemsIntoLines(textContent.items);

            for (const line of lines) {
                {
                    const roMatch = line.match(/Part\s+Preview\s+RO\s*#?\s*([A-Z0-9-]+)/i);
                    if (roMatch) {
                        const foundRO = String(roMatch[1]).trim();
                        if (roNumber && foundRO !== roNumber) throw new Error("This PDF contains multiple ROs. Choose one Part Preview PDF per RO.");
                        roNumber = foundRO;
                    }
                }

                const parsed = parseAutoMateTextLine(line);
                if (!parsed) continue;

                const existing = importedMap.get(parsed.part_number);
                if (existing) {
                    existing.quantity += parsed.quantity;
                    if ((!existing.part_name || existing.part_name === "Not entered") && parsed.part_name) {
                        existing.part_name = parsed.part_name;
                    }
                } else {
                    importedMap.set(parsed.part_number, parsed);
                }
            }
        }

        const parts = Array.from(importedMap.values());
        const totalPieces = parts.reduce((sum, part) => sum + part.quantity, 0);

        if (!roNumber) {
            throw new Error("Could not find the RO number. Use an Auto/Mate Part Preview report.");
        }

        if (!parts.length) {
            const error = new Error("Could not read any parts from the report.");
            error.ro_number = roNumber;
            throw error;
        }

        return {
            ro_number: roNumber,
            parts: parts,
            total_pieces: totalPieces,
            file_name: file.name
        };


    } finally {
        try { await loadingTask.destroy(); } catch (error) { console.warn("PDF cleanup failed:", error); }
    }
}

