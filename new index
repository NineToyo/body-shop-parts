function getROGroupNumbers(jobGroup, fallbackRO) {
    const raw = String(jobGroup || fallbackRO || "");
    return [...new Set(
        raw.split("/")
            .map(ro => ro.trim())
            .filter(ro => /^\d+$/.test(ro))
    )].sort((a, b) => Number(b) - Number(a));
}

function getROGroupSortValue(jobGroup, fallbackRO) {
    const numbers = getROGroupNumbers(jobGroup, fallbackRO);
    return numbers.length ? Math.max(...numbers.map(Number)) : 0;
}


async function getOpenROContext(roNumber) {
    const { data: row, error } = await supabaseClient
        .from("repair_orders")
        .select("ro_number, technician, job_group, automate_active")
        .eq("ro_number", roNumber)
        .maybeSingle();

    if (error) throw error;
    if (!row) return null;

    if (row.automate_active === true) {
        return {
            ...row,
            requested_ro: roNumber,
            open_ro: row.ro_number
        };
    }

    const groupNumbers = getROGroupNumbers(row.job_group, row.ro_number);
    if (groupNumbers.length <= 1) return null;

    const { data: openRows, error: groupError } = await supabaseClient
        .from("repair_orders")
        .select("ro_number, technician, job_group, automate_active")
        .in("ro_number", groupNumbers)
        .eq("automate_active", true)
        .limit(1);

    if (groupError) throw groupError;
    const openRow = openRows?.[0];
    if (!openRow) return null;

    return {
        ...row,
        technician: row.technician && row.technician !== "Unassigned"
            ? row.technician
            : openRow.technician,
        automate_active: true,
        requested_ro: roNumber,
        open_ro: openRow.ro_number,
        job_group: row.job_group || openRow.job_group
    };
}

async function loadTechnicianROs(technician) {
    selectedTechnician = technician;
    const status = document.getElementById("techLookupStatus");
    const card = document.getElementById("techROResults");
    const list = document.getElementById("techROList");
    const count = document.getElementById("techROCount");

    status.textContent = `Loading ${technician}'s repair orders...`;
    status.className = "tech-lookup-status";

    const { data, error } = await supabaseClient
        .from("repair_orders")
        .select("ro_number, job_group, vehicle_year, vehicle_make, vehicle_model")
        .eq("technician", technician)
        .eq("automate_active", true);

    if (error) {
        console.error(error);
        status.textContent = "Could not load repair orders: " + error.message;
        status.className = "tech-lookup-status error";
        return;
    }

    const groups = new Map();

    (data || []).forEach(ro => {
        const numbers = getROGroupNumbers(ro.job_group, ro.ro_number);
        const groupKey = numbers.join("/") || String(ro.ro_number || "");
        if (!groupKey) return;

        const vehicleInfo = [ro.vehicle_year, ro.vehicle_make, ro.vehicle_model]
            .map(value => String(value || "").trim())
            .filter(Boolean)
            .join(" ");

        if (!groups.has(groupKey)) {
            groups.set(groupKey, {
                display: groupKey,
                roNumbers: numbers.length ? numbers : [String(ro.ro_number)],
                sortValue: getROGroupSortValue(groupKey, ro.ro_number),
                vehicleInfo
            });
        } else if (!groups.get(groupKey).vehicleInfo && vehicleInfo) {
            groups.get(groupKey).vehicleInfo = vehicleInfo;
        }
    });

    const jobs = Array.from(groups.values())
        .sort((a, b) => b.sortValue - a.sortValue);

    document.getElementById("techROTitle").textContent = technician + " — Repair Orders";
    count.textContent = `${jobs.length} active job${jobs.length === 1 ? "" : "s"}`;

    list.innerHTML = jobs.length
        ? jobs.map(job => {
            const roArg = escapeJs(job.roNumbers.join("/"));
            const vehicleLine = job.vehicleInfo
                ? `<div class="catalog-count" style="font-weight:700; margin-top:4px;">${escapeHtml(job.vehicleInfo)}</div>`
                : "";
            return `<div class="ro-card" onclick="searchPartsByROGroup('${roArg}')"><strong>RO ${escapeHtml(job.display.replaceAll("/", " / "))}</strong>${vehicleLine}<div class="catalog-count">Tap to view received parts from ${job.roNumbers.length === 1 ? "this RO" : "either RO"}</div></div>`;
        }).join("")
        : `<div class="empty">No active repair orders are assigned to ${escapeHtml(technician)}.</div>`;

    card.style.display = "block";
    document.getElementById("techLookupResults").style.display = "none";
    status.textContent = "";
    status.className = "tech-lookup-status";
}

async function searchPartsByROGroup(roGroup) {
    const roNumbers = getROGroupNumbers(roGroup, roGroup);
    const displayRO = roNumbers.join(" / ");
    const status = document.getElementById("techLookupStatus");
    const resultsCard = document.getElementById("techLookupResults");
    const resultsTable = document.getElementById("techLookupTable");
    const resultsTitle = document.getElementById("techResultsTitle");
    const resultsCount = document.getElementById("techResultsCount");

    if (!roNumbers.length) {
        status.textContent = "Could not determine the repair order number.";
        status.className = "tech-lookup-status error";
        return;
    }

    status.textContent = "Checking parts...";

    const { data: receivedParts, error } = await supabaseClient
        .from("parts")
        .select("id, ro_number, part_number, quantity, location, received_at")
        .in("ro_number", roNumbers)
        .order("received_at", { ascending: false });

    if (error) {
        console.error(error);
        status.textContent = "Could not look up parts: " + error.message;
        status.className = "tech-lookup-status error";
        return;
    }

    resultsTitle.textContent = "Parts for RO " + displayRO;
    const partNumbers = [...new Set((receivedParts || []).map(p => p.part_number).filter(Boolean))];
    let catalogMap = {};

    if (partNumbers.length) {
        const { data: catalogParts } = await supabaseClient
            .from("parts_catalog")
            .select("part_number, part_name")
            .in("part_number", partNumbers);
        (catalogParts || []).forEach(p => catalogMap[p.part_number] = p);
    }

    if (!receivedParts || !receivedParts.length) {
        resultsTable.innerHTML = `<tr><td colspan="5" class="empty">No parts have been received for RO ${escapeHtml(displayRO)} yet.</td></tr>`;
        resultsCount.textContent = "No received parts found";
    } else {
        resultsTable.innerHTML = receivedParts.map(part => {
            const c = catalogMap[part.part_number];
            const description = c ? (c.part_name || "Not entered") : "Part not in catalog";
            const received = part.received_at ? new Date(part.received_at).toLocaleString() : "—";
            return `<tr><td>${escapeHtml(part.part_number)}</td><td>${escapeHtml(description)}</td><td>${escapeHtml(part.quantity)}</td><td class="tech-location">${escapeHtml(part.location)}</td><td>${escapeHtml(received)}</td></tr>`;
        }).join("");
        resultsCount.textContent = `${receivedParts.length} received part${receivedParts.length === 1 ? "" : "s"}${roNumbers.length > 1 ? " across both ROs" : ""}`;
    }

    document.getElementById("techROResults").style.display = "none";
    resultsCard.style.display = "block";
    status.textContent = "";
    status.className = "tech-lookup-status";
}

