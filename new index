function setVehicleLookupStatus(message, type = "") {
    const el = document.getElementById("vehicleLookupStatus");
    if (!el) return;
    el.textContent = message || "";
    el.className = "tech-lookup-status" + (type ? " " + type : "");
}

function normalizeVehicleLookupTerm(value) {
    return String(value || "")
        .trim()
        .replace(/^ro\s*#?\s*/i, "")
        .replace(/^tag\s*#?\s*/i, "")
        .trim();
}

function firstTrackerValue(rows, field) {
    const ranked = [...(rows || [])].sort((a, b) => {
        const aRank = (a.automate_active === true ? 4 : 0) + (a.active === true ? 2 : 0) + (a.technician && a.technician !== "Unassigned" ? 1 : 0);
        const bRank = (b.automate_active === true ? 4 : 0) + (b.active === true ? 2 : 0) + (b.technician && b.technician !== "Unassigned" ? 1 : 0);
        return bRank - aRank;
    });

    for (const row of ranked) {
        const value = String(row?.[field] ?? "").trim();
        if (value) return value;
    }
    return "";
}

function buildVehicleLookupGroups(rows) {
    const groups = new Map();

    for (const row of rows || []) {
        const numbers = getROGroupNumbers(row.job_group, row.ro_number);
        const groupKey = numbers.join("/") || String(row.ro_number || "");
        if (!groupKey) continue;
        if (!groups.has(groupKey)) groups.set(groupKey, []);
        groups.get(groupKey).push(row);
    }

    return Array.from(groups.entries())
        .map(([groupKey, groupRows]) => ({
            groupKey,
            rows: groupRows,
            roNumbers: [...new Set(groupRows.flatMap(row => getROGroupNumbers(row.job_group, row.ro_number)))].sort((a, b) => Number(b) - Number(a)),
            sortValue: getROGroupSortValue(groupKey, groupRows[0]?.ro_number)
        }))
        .sort((a, b) => b.sortValue - a.sortValue);
}

async function searchVehicleLookup() {
    const input = document.getElementById("vehicleLookupInput");
    const results = document.getElementById("vehicleLookupResults");
    const term = normalizeVehicleLookupTerm(input?.value);

    if (!term) {
        setVehicleLookupStatus("Enter an RO or tag number.", "error");
        if (results) results.style.display = "none";
        return;
    }

    setVehicleLookupStatus("Searching...", "");
    if (results) {
        results.style.display = "none";
        results.innerHTML = "";
    }

    const fields = [
        "ro_number", "job_group", "technician", "active", "automate_active",
        "vehicle_year", "vehicle_make", "vehicle_model",
        "tag_number", "advisor", "customer_name", "insurance",
        "collision_vehicle", "collision_status", "tracker_note", "tracker_date"
    ].join(",");

    try {
        const [roResult, tagResult] = await Promise.all([
            supabaseClient.from("repair_orders").select(fields).eq("ro_number", term),
            supabaseClient.from("repair_orders").select(fields).eq("tag_number", term)
        ]);

        const schemaError = roResult.error || tagResult.error;
        if (schemaError) {
            const message = String(schemaError.message || "");
            if (/tag_number|advisor|customer_name|collision_vehicle|collision_status|tracker_note|tracker_date|schema cache/i.test(message)) {
                setVehicleLookupStatus("Vehicle Lookup setup is not finished yet. Run the new Supabase vehicle-lookup SQL, then refresh the app.", "error");
                return;
            }
            throw schemaError;
        }

        const rowMap = new Map();
        [...(roResult.data || []), ...(tagResult.data || [])].forEach(row => {
            rowMap.set(String(row.ro_number), row);
        });

        if (!rowMap.size) {
            setVehicleLookupStatus(`No repair order or tag ${term} was found.`, "error");
            return;
        }

        // If the match belongs to a paired RO, load the other member(s) so the
        // advisor sees one complete job instead of two disconnected records.
        const relatedNumbers = [...new Set(
            Array.from(rowMap.values())
                .flatMap(row => getROGroupNumbers(row.job_group, row.ro_number))
        )];

        if (relatedNumbers.length) {
            const { data: relatedRows, error: relatedError } = await supabaseClient
                .from("repair_orders")
                .select(fields)
                .in("ro_number", relatedNumbers);
            if (relatedError) throw relatedError;
            (relatedRows || []).forEach(row => rowMap.set(String(row.ro_number), row));
        }

        const groups = buildVehicleLookupGroups(Array.from(rowMap.values()));
        const allROs = [...new Set(groups.flatMap(group => group.roNumbers))];

        let parts = [];
        if (allROs.length) {
            const { data: partRows, error: partsError } = await supabaseClient
                .from("parts")
                .select("ro_number, quantity")
                .in("ro_number", allROs);
            if (!partsError) parts = partRows || [];
            else console.error("Vehicle lookup parts summary failed:", partsError);
        }

        const cards = groups.map(group => {
            const rows = group.rows;
            const vehicle = [
                firstTrackerValue(rows, "vehicle_year"),
                firstTrackerValue(rows, "vehicle_make"),
                firstTrackerValue(rows, "vehicle_model")
            ].filter(Boolean).join(" ") || firstTrackerValue(rows, "collision_vehicle") || "Vehicle information not available";

            const trackerVehicle = firstTrackerValue(rows, "collision_vehicle");
            const tag = firstTrackerValue(rows, "tag_number") || "—";
            const advisor = firstTrackerValue(rows, "advisor") || "—";
            const customer = firstTrackerValue(rows, "customer_name") || "—";
            const insurance = firstTrackerValue(rows, "insurance") || "—";
            const collisionStatus = firstTrackerValue(rows, "collision_status") || "—";
            const note = firstTrackerValue(rows, "tracker_note");
            const trackerDate = firstTrackerValue(rows, "tracker_date");
            const technician = firstTrackerValue(rows.filter(row => row.technician !== "Unassigned"), "technician") || "Unassigned";
            const isOpen = rows.some(row => row.automate_active === true);
            const displayRO = group.roNumbers.length ? group.roNumbers.join(" / ") : group.groupKey.replaceAll("/", " / ");

            const groupPartRows = parts.filter(part => group.roNumbers.includes(String(part.ro_number)));
            const pieces = groupPartRows.reduce((sum, part) => sum + (Number(part.quantity) || 0), 0);

            const trackerVehicleDetail = trackerVehicle && trackerVehicle.toLowerCase() !== vehicle.toLowerCase()
                ? `<div class="vehicle-detail"><span>Collision Tracker Vehicle</span><strong>${escapeHtml(trackerVehicle)}</strong></div>`
                : "";

            return `
                <div class="vehicle-lookup-card">
                    <div class="vehicle-lookup-head">
                        <div>
                            <div class="vehicle-lookup-ro">RO ${escapeHtml(displayRO)}</div>
                            <div class="vehicle-lookup-vehicle">${escapeHtml(vehicle)}</div>
                        </div>
                        <span class="lookup-badge ${isOpen ? "open" : "closed"}">${isOpen ? "OPEN" : "NOT OPEN"}</span>
                    </div>
                    <div class="vehicle-lookup-grid">
                        <div class="vehicle-detail"><span>Tag #</span><strong>${escapeHtml(tag)}</strong></div>
                        <div class="vehicle-detail"><span>Advisor</span><strong>${escapeHtml(advisor)}</strong></div>
                        <div class="vehicle-detail"><span>Customer</span><strong>${escapeHtml(customer)}</strong></div>
                        <div class="vehicle-detail"><span>Body Tech</span><strong>${escapeHtml(technician)}</strong></div>
                        <div class="vehicle-detail"><span>Shop Status</span><strong>${escapeHtml(collisionStatus)}</strong></div>
                        <div class="vehicle-detail"><span>Insurance</span><strong>${escapeHtml(insurance)}</strong></div>
                        ${trackerVehicleDetail}
                        ${trackerDate ? `<div class="vehicle-detail"><span>Tracker Date</span><strong>${escapeHtml(trackerDate)}</strong></div>` : ""}
                    </div>
                    ${note ? `<div class="vehicle-lookup-note"><strong>Tracker Note</strong>${escapeHtml(note)}</div>` : ""}
                    <div class="vehicle-parts-summary">Received parts: ${groupPartRows.length} line${groupPartRows.length === 1 ? "" : "s"} / ${pieces} piece${pieces === 1 ? "" : "s"}</div>
                </div>`;
        }).join("");

        results.innerHTML = cards;
        results.style.display = "block";
        setVehicleLookupStatus(`${groups.length} matching job${groups.length === 1 ? "" : "s"} found.`, "success");
    } catch (error) {
        console.error("Vehicle lookup failed:", error);
        setVehicleLookupStatus("Could not search vehicle records: " + (error?.message || "Unknown error."), "error");
    }
}

