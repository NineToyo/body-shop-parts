async function receiveExpectedPart(index) {
    if (!requireAdmin() || receiveBusy || receivedEditBusy) return;
    const state = receiveChecklistState;
    const row = state?.verification.rows[index];
    const ro = document.getElementById("roNumber").value.trim();
    if (!row || state.roNumber !== ro || row.expected <= row.scanned) return;
    if (!document.getElementById("location").value.trim()) {
        toast("Enter a rack / location above first.", "error");
        document.getElementById("location").focus(); return;
    }
    const answer = prompt("Receive " + row.part_number + " for RO " + ro + "\nQuantity arriving now (" + (row.expected-row.scanned) + " still expected):", String(row.expected-row.scanned));
    if (answer === null) return;
    const quantity = Number(answer);
    if (!Number.isSafeInteger(quantity) || quantity < 1) { alert("Enter a whole quantity of at least 1."); return; }
    if (state !== receiveChecklistState || ro !== document.getElementById("roNumber").value.trim()) { toast("The RO list changed. Try again.", "error"); return; }
    document.getElementById("partNumber").value = row.part_number;
    document.getElementById("quantity").value = quantity;
    try { await receivePart(); }
    finally { document.getElementById("quantity").value = "1"; }
}

async function openReceivedPartEditor(id) {
    if (!requireAdmin() || receiveBusy || receivedEditBusy || receivedEditorLoading) return;
    receivedEditorLoading = true;
    try {
        const {data, error} = await supabaseClient.from("parts").select("id, ro_number, part_number, quantity, location").eq("id", id).single();
        if (error || !data) throw error || new Error("Receipt no longer exists.");
        receivedEditOriginal = data;
        document.getElementById("receiptEditRO").textContent = "RO " + data.ro_number;
        document.getElementById("receiptEditNumber").value = data.part_number;
        document.getElementById("receiptEditQuantity").value = data.quantity;
        document.getElementById("receiptEditLocation").value = data.location;
        document.getElementById("receiptEditStatus").textContent = "";
        document.getElementById("receiptEditDialog").showModal();
    } catch (error) { toast("Could not open receipt: " + error.message, "error"); }
    finally { receivedEditorLoading = false; }
}

function closeReceivedPartEditor() {
    if (receivedEditBusy) return;
    document.getElementById("receiptEditDialog").close();
    receivedEditOriginal = null;
}

async function saveReceivedPartEdit(event) {
    event.preventDefault();
    if (!requireAdmin() || receiveBusy || receivedEditBusy || !receivedEditOriginal) return;
    const original = receivedEditOriginal;
    const part_number = document.getElementById("receiptEditNumber").value.trim();
    const quantity = Number(document.getElementById("receiptEditQuantity").value);
    const location = document.getElementById("receiptEditLocation").value.trim();
    const status = document.getElementById("receiptEditStatus");
    if (!part_number || !location || !Number.isSafeInteger(quantity) || quantity < 1) {
        status.textContent = "Enter a part number, location and whole quantity of at least 1."; return;
    }
    receivedEditBusy = true;
    document.getElementById("receiptEditSave").disabled = true;
    status.textContent = "Saving...";
    let saved = false;
    try {
        // Match the original values so a coworker's intervening edit is not overwritten.
        const {data, error} = await supabaseClient.from("parts").update({part_number, quantity, location})
            .eq("id", original.id).eq("ro_number", original.ro_number).eq("part_number", original.part_number)
            .eq("quantity", original.quantity).eq("location", original.location).select("id");
        if (error) throw error;
        if (!data?.length) throw new Error("Receipt changed or could not be updated. Close and reopen it to refresh.");
        saved = true;
        dashboardCacheAt = 0;
        toast("Received part updated for RO " + original.ro_number + ".", "success");
        const refreshes = await Promise.allSettled([loadRecentParts(), loadReceiveChecklist(), loadAllParts()]);
        if (refreshes.some(result => result.status === "rejected")) toast("Saved. Refresh the lists to see the latest quantities.", "error");
    } catch (error) { status.textContent = "Could not save: " + error.message; }
    finally {
        receivedEditBusy = false;
        document.getElementById("receiptEditSave").disabled = false;
        if (saved) closeReceivedPartEditor();
    }
}

async function fetchCatalogMap(partNumbers) {
    const uniqueNumbers = [...new Set(
        (partNumbers || [])
            .map(value => String(value || "").trim())
            .filter(Boolean)
    )];

    const map = new Map();
    for (let i = 0; i < uniqueNumbers.length; i += 100) {
        const chunk = uniqueNumbers.slice(i, i + 100);
        const { data, error } = await supabaseClient
            .from("parts_catalog")
            .select("part_number, part_name")
            .in("part_number", chunk);

        if (error) {
            console.error("Catalog batch lookup error:", error);
            continue;
        }

        (data || []).forEach(part => map.set(String(part.part_number), part));
    }
    return map;
}

async function loadRecentParts() {
    const { data, error } = await supabaseClient
        .from("parts")
        .select("*")
        .order("received_at", { ascending: false })
        .limit(25);

    if (error) {
        console.error("Error loading parts:", error);
        return;
    }

    const table = document.getElementById("partsTable");
    table.innerHTML = "";

    if (!data || data.length === 0) {
        table.innerHTML = `<tr><td colspan="7" class="empty">No parts received yet.</td></tr>`;
        return;
    }

    const catalogMap = await fetchCatalogMap(data.map(part => part.part_number));
    for (const part of data) {
        addPartToScreen(part, catalogMap.get(String(part.part_number)) || null, false);
    }
}

