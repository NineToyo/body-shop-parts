function pushDeadline(promise, message) {
    let timer;
    return Promise.race([promise, new Promise((_, reject) => {
        timer = setTimeout(() => reject(new Error(message)), 8000);
    })]).finally(() => clearTimeout(timer));
}

async function devicePushRegistration() {
    if (!("serviceWorker" in navigator)) throw new Error("Service workers are unavailable in this browser.");
    const registration = await pushDeadline(navigator.serviceWorker.getRegistration(), "Could not find the service worker. Reload and try again.");
    if (!registration) throw new Error("The app's service worker is missing. Reload the app and try again.");
    const ready = registration.active ? registration : await pushDeadline(navigator.serviceWorker.ready, "The service worker is not ready. Reload and try again.");
    if (!ready.pushManager) throw new Error("PushManager is unavailable in this browser.");
    return ready;
}

function notificationSupportProblem() {
    const ios = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    const installed = navigator.standalone === true || (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches);
    if (ios && !installed) return "To enable notifications on iPhone or iPad, Add to Home Screen, then open the app from that icon.";
    if (!window.isSecureContext) return "Notifications require a secure HTTPS connection.";
    if (!("Notification" in window)) return "Notifications are unavailable in this browser. Use a browser that supports web push.";
    if (!("serviceWorker" in navigator)) return "Service workers are unavailable in this browser.";
    if (!("PushManager" in window)) return "PushManager is unavailable. This browser or installed app does not support web push.";
    if (Notification.permission === "denied") return "Notifications are blocked. Allow notifications for this app in your browser or device settings, then try again.";
    return "";
}

