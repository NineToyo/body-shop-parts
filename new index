        if (epoch !== notificationEpoch || remembered !== getRememberedTechnician()) return;
        if (subscription && subscription.endpoint === binding.endpoint) {
            statusEl.textContent = "Notifications: ON for " + remembered;
            statusEl.className = "tech-lookup-status success";
            enableButton.style.display = "none";
        } else { clearPushBinding(); }
    } catch (error) { console.error("Notification state check:", error); }
}

function urlBase64ToUint8Array(base64String) {
    const padding = "=".repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
    const rawData = atob(base64);
    return Uint8Array.from([...rawData].map(c => c.charCodeAt(0)));
}

async function cleanupDevicePush(endpoint, suppliedSubscription) {
    let subscription = suppliedSubscription;
    let failed = false;
    if (!subscription) {
        try {
            const registration = await devicePushRegistration();
            subscription = await pushDeadline(registration.pushManager.getSubscription(), "Subscription lookup timed out.");
        } catch (error) { failed = true; console.error("Push lookup cleanup:", error); }
    }
    // Browser delivery and server cleanup are independent: neither failure skips the other.
    if (subscription) {
        endpoint = subscription.endpoint;
        try {
            const removed = await pushDeadline(subscription.unsubscribe(), "Push unsubscribe timed out.");
            if (!removed) throw new Error("Push unsubscribe was not completed.");
        } catch (error) { failed = true; console.error("Push unsubscribe cleanup:", error); }
    }
    if (endpoint) {
        try {
            const {data, error} = await pushDeadline(supabaseClient.functions.invoke("push-notifications", {
                body: {action: "unregister", endpoint}
            }), "Push server cleanup timed out.");
            if (error || data?.error) throw new Error(data?.error || error.message);
        } catch (error) { failed = true; console.error("Push server cleanup:", error); }
    }
    return !failed;
}

async function enableNotifications() {
    if (notificationBusy) return;
    const technician = getRememberedTechnician();
    if (!technician) { notificationFeedback("Choose your technician name first.", true); return; }
    const problem = notificationSupportProblem();
    if (problem) { notificationFeedback(problem, true); return; }
    const epoch = notificationEpoch;
    const current = () => epoch === notificationEpoch && technician === getRememberedTechnician();
    notificationBusy = true;
    let subscription;
    let stage = "permission";
    try {
        // Request permission directly from the user's button gesture (required on iOS).
        const permission = await Notification.requestPermission();
        if (!current()) return;
        if (permission !== "granted") throw new Error(permission === "denied" ? "Notifications are blocked. Allow them in browser or device settings and try again." : "Notification permission was not granted. Tap Enable Notifications and choose Allow.");
        stage = "service worker";
        await pushCleanupTask;
        if (!current()) return;
        const registration = await devicePushRegistration();
        if (!current()) return;
        stage = "subscription";
        subscription = await pushDeadline(registration.pushManager.getSubscription(), "Could not read the device subscription.");
        if (!current()) return;
        if (!subscription) {
            // Do not race subscribe against a timer: a late success would create an untracked subscription.
            subscription = await registration.pushManager.subscribe({userVisibleOnly: true, applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)});
        }
        if (!current()) { await cleanupDevicePush(subscription.endpoint, subscription); return; }
        stage = "server registration";
        clearPushBinding();
        // Keep registration serialized; compensate if technician changes while it is in flight.
        const {data, error} = await supabaseClient.functions.invoke("push-notifications", {
            body: {action: "register", technician, subscription: subscription.toJSON()}
        });
        if (!current()) { await cleanupDevicePush(subscription.endpoint, subscription); return; }
        if (error || data?.error) throw new Error(data?.error || error?.message || "Registration failed.");
        localStorage.setItem(DEVICE_PUSH_KEY, JSON.stringify({technician, endpoint: subscription.endpoint}));
        await refreshTechnicianDeviceUI();
        if (current()) notificationFeedback("Notifications enabled for " + technician + ".");
    } catch (error) {
        clearPushBinding();
        if (subscription) await cleanupDevicePush(subscription.endpoint, subscription);
        if (current()) notificationFeedback("Notifications OFF — " + stage + ": " + (error?.message || "Setup failed. Try again."), true);
    } finally { notificationBusy = false; }
}

function changeTechnician() {
    if (!confirm("Change technician? Notifications for the current technician will be disabled on this device.")) return;
    const binding = readPushBinding();
    notificationEpoch++;
    technicianOverride = null;
    selectedTechnician = null;
    // Reset local identity and UI before starting any asynchronous push cleanup.
    try { localStorage.removeItem(DEVICE_TECH_KEY); }
    catch (error) {
        try { localStorage.setItem(DEVICE_TECH_KEY, ""); } catch (storageError) { console.error(storageError); }
    }
    clearPushBinding();
    document.getElementById("techROResults").style.display = "none";
    document.getElementById("techLookupResults").style.display = "none";
    void refreshTechnicianDeviceUI();
    const status = document.getElementById("techLookupStatus");
    status.textContent = "Technician cleared. Choose a technician. Notifications are OFF until you enable them.";
    status.className = "tech-lookup-status success";
    pushCleanupTask = pushCleanupTask.then(async () => {
        try {
            const cleaned = await cleanupDevicePush(binding?.endpoint);
            if (!cleaned && !getRememberedTechnician()) {
                status.textContent = "Technician cleared. Push cleanup could not finish; old alerts may still arrive. Reconnect and try enabling notifications after selecting your technician.";
                status.className = "tech-lookup-status error";
            }
        } catch (error) { console.error("Best-effort push cleanup:", error); }
    });
}

