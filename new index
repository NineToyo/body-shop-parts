async function startBarcodeScanner() {

    const scannerContainer =
        document.getElementById(
            "scannerContainer"
        );

    /*
     * If a scanner already exists,
     * completely shut it down first.
     */

    if (barcodeScanner) {

        try {
            await barcodeScanner.stop();
        } catch (error) {
            console.log(
