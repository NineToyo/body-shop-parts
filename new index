async function lookupPart() {
    const input = document.getElementById("partNumber");
    const partInfo = document.getElementById("partInfo");
    const partNumber = input?.value.trim() || "";
    if (!partNumber) {
        partInfo.textContent = "Part description will appear here";
        return;
    }

    partInfo.textContent = "Looking up part...";
    try {
        const key = normalizeReceivedPartKey(partNumber);
        if (!catalogCache) {
            const { data, error } = await supabaseClient
                .from("parts_catalog")
                .select("part_number, part_name")
                .order("part_number", { ascending: true });
            if (error) throw error;
            catalogCache = data || [];
        }
        const match = (catalogCache || []).find(part => normalizeReceivedPartKey(part.part_number) === key);
        if (!match) {
            partInfo.textContent = "Part not found in catalog — it can still be received.";
            return;
        }
        partInfo.textContent = match.part_name || "Not entered";
    } catch (error) {
        console.error(error);
        partInfo.textContent = "Error looking up part.";
    }
}

