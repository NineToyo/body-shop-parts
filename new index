function normalizeReceivedPartKey(value) {
    return String(value || "")
        .trim()
        .toUpperCase()
        .replace(/[^A-Z0-9]/g, "");
}

async function receivePart() {
    if (receiveBusy || receivedEditBusy) return;
    try { return await saveReceivedPart(); }
    catch (error) { console.error(error); alert("Could not finish receiving. Refresh the list before retrying to avoid duplicates."); }
    finally { setReceiveBusy(false); }
}

async function saveReceivedPart() {

    if (!requireAdmin()) return;
    if (receiveBusy) return;

    const roNumber =
        document
            .getElementById("roNumber")
            .value
            .trim();

    const partNumber =
        document
            .getElementById("partNumber")
            .value
            .trim();

    const quantity =
        document
            .getElementById("quantity")
            .value;

    const location =
        document
            .getElementById("location")
            .value
            .trim();

    if (!roNumber) {

        alert(
            "Please enter the Repair Order number."
        );

        return;
    }

    if (!partNumber) {

        alert(
            "Please scan or enter the part number."
        );

        return;
    }

    if (!location) {

        alert(
            "Please enter the part location."
        );

        return;
    }

    if (!Number.isSafeInteger(Number(quantity)) || Number(quantity) < 1) {
        alert("Enter a whole quantity of at least 1."); return;
    }
    setReceiveBusy(true);

    let assignment;
    try {
        assignment = await getOpenROContext(roNumber);
    } catch (assignmentError) {
        setReceiveBusy(false);
        alert("Could not check RO assignment:\n\n" + assignmentError.message);
        return;
    }

    if (!assignment) {
        setReceiveBusy(false);
        alert("RO " + roNumber + " is not currently part of an Open Auto/Mate job.");
        return;
    }

    // Warn before receiving the same part again on this physical job.
    // Formatting differences such as 52119-AK900 vs 52119AK900 are treated
    // as the same part number. We warn instead of blocking because duplicate
    // quantities can be legitimate.
    const duplicateKey = normalizeReceivedPartKey(partNumber);
    const relatedROs = getROGroupNumbers(assignment.job_group, roNumber);
    const duplicateROs = relatedROs.length ? relatedROs : [roNumber];

    const { data: existingReceived, error: duplicateCheckError } =
        await supabaseClient
            .from("parts")
            .select("ro_number, part_number, quantity, location, received_at")
            .in("ro_number", duplicateROs);

    if (duplicateCheckError) {
        console.error("Could not check for duplicate received part:", duplicateCheckError);
        setReceiveBusy(false);
        alert("Could not check whether this part was already received. Please try again.");
        return;
    }

    const duplicateMatches = (existingReceived || []).filter(part =>
        normalizeReceivedPartKey(part.part_number) === duplicateKey
    );

    if (duplicateMatches.length) {
        const locations = [...new Set(duplicateMatches
            .map(part => String(part.location || "").trim())
            .filter(Boolean))];
        const roList = [...new Set(duplicateMatches.map(part => String(part.ro_number || roNumber)))];
        const existingQty = duplicateMatches.reduce(
            (total, part) => total + (Number(part.quantity) || 0),
            0
        );

        const warning =
            `This part has already been received on ${roList.length === 1 ? "RO " + roList[0] : "this job (ROs " + roList.join(" / ") + ")"}.\n\n` +
            `Part: ${partNumber}\n` +
            `Existing received quantity: ${existingQty || duplicateMatches.length}` +
            (locations.length ? `\nLocation${locations.length === 1 ? "" : "s"}: ${locations.join(", ")}` : "") +
            `\n\nReceive it again?`;

        if (!confirm(warning)) { setReceiveBusy(false); return; }
    }

    // Unassigned Open ROs are valid receiving targets. Parts are stored by RO
    // number, so when the RO is assigned later the existing received parts
    // automatically appear under that technician with no rescanning required.

    const { data, error } =
        await supabaseClient
            .from("parts")
            .insert([
                {
                    ro_number: roNumber,
                    part_number: partNumber,
                    quantity: Number(quantity),
                    location: location
                }
            ])
            .select();

    if (error) {

        console.error(error);
        setReceiveBusy(false);

        alert(
            "There was a problem saving the part:\n\n" +
            error.message
        );

        return;
    }

    void loadReceiveChecklist(partNumber);

    /*
     * Automatically add newly received parts to the catalog.
     * Existing catalog entries are never overwritten.
     */

    const { data: existingCatalogPart, error: catalogCheckError } =
        await supabaseClient
            .from("parts_catalog")
            .select("part_number")
            .eq("part_number", partNumber)
            .maybeSingle();

    if (catalogCheckError) {
        console.error("Could not check parts catalog:", catalogCheckError);
    } else if (!existingCatalogPart) {
        const { error: catalogInsertError } =
            await supabaseClient
                .from("parts_catalog")
                .insert([
                    {
                        part_number: partNumber,
                        manufacturer: "Not entered",
                        part_name: "Not entered"
                    }
                ]);

        if (catalogInsertError) {
            console.error("Could not automatically add part to catalog:", catalogInsertError);
        } else {
            invalidateCatalogCache();
        }
    }

    await loadRecentParts();

    /*
     * Make absolutely sure
     * the camera is stopped.
     */

    if (barcodeScanner) {

        try {

            await barcodeScanner.stop();

            barcodeScanner.clear();

        } catch (error) {

            console.error(
                "Camera cleanup:",
                error
            );
        }

        barcodeScanner = null;

        document
            .getElementById(
                "scannerContainer"
            )
            .style.display = "none";
    }

    /*
     * Clear only the part information.
     * The active RO stays.
     */

    document
        .getElementById("partNumber")
        .value = "";

    document
        .getElementById("partInfo")
        .textContent =
        "Part description will appear here";

    document
        .getElementById("partNumber")
        .focus();

    localStorage.setItem("bodyshop_last_ro", roNumber);
    localStorage.setItem("bodyshop_last_location", location);
    updateReceiveSession(1);
    setReceiveBusy(false);
    dashboardCacheAt = 0;
    navigator.vibrate?.(55);
    toast(`${partNumber} received to RO ${roNumber} — ${location}`, "success", 2500);
    if (document.getElementById("homePage")?.classList.contains("active")) loadDashboard(true);
}

