async function deletePart(partNumber) {

    if (!requireAdmin()) return;

    const confirmed =
        confirm(
            `Are you sure you want to delete part ${partNumber}?`
        );

    if (!confirmed) {
        return;
    }

    const { error } =
        await supabaseClient
            .from("parts_catalog")
            .delete()
            .eq(
                "part_number",
                partNumber
            );

    if (error) {

        console.error(error);

        showStatus(
            "Could not delete part: " +
            error.message,
            "error"
        );

        return;
    }

    showStatus("", "");

    invalidateCatalogCache();
    await loadCatalog(true);
}

