async function loadDashboard(force = false) {
    const now = Date.now();
    if (!force && now - dashboardCacheAt < 30000) return;
    dashboardCacheAt = now;

    const ids = ["dashOpenROs","dashAssignedROs","dashUnassignedROs","dashPartsToday","dashTrackerCoverage","dashLastAutomate"];
    ids.forEach(id => { const el = document.getElementById(id); if (el && el.textContent === "") el.textContent = "—"; });

    try {
        const { data: openRows, error: roError } = await supabaseClient
            .from("repair_orders")
            .select("ro_number, technician, tag_number, advisor, customer_name, collision_vehicle, vehicle_year, vehicle_make, vehicle_model, automate_last_seen_at")
            .eq("automate_active", true);
        if (roError) throw roError;

        const rows = openRows || [];
        const unassigned = rows.filter(row => !row.technician || row.technician === "Unassigned");
        const assigned = rows.length - unassigned.length;
        const trackerCovered = rows.filter(row => row.tag_number || row.advisor || row.customer_name || row.collision_vehicle).length;
        const lastSeen = rows
            .map(row => row.automate_last_seen_at ? new Date(row.automate_last_seen_at).getTime() : 0)
            .filter(Boolean)
            .sort((a,b) => b-a)[0] || 0;

        document.getElementById("dashOpenROs").textContent = rows.length;
        document.getElementById("dashAssignedROs").textContent = assigned;
        document.getElementById("dashUnassignedROs").textContent = unassigned.length;
        document.getElementById("dashTrackerCoverage").textContent = rows.length ? `${trackerCovered} / ${rows.length} open ROs` : "No open ROs";
        document.getElementById("dashLastAutomate").textContent = lastSeen ? new Date(lastSeen).toLocaleString() : "Not synced yet";

        const list = document.getElementById("dashboardUnassignedList");
        const note = document.getElementById("dashUnassignedNote");
        if (note) note.textContent = unassigned.length ? `${unassigned.length} open job${unassigned.length === 1 ? "" : "s"} waiting` : "All open jobs have a tech";
        if (list) {
            const sorted = [...unassigned].sort((a,b) => Number(b.ro_number) - Number(a.ro_number)).slice(0,6);
            list.innerHTML = sorted.length ? sorted.map(row => {
                const vehicle = row.collision_vehicle || [row.vehicle_year,row.vehicle_make,row.vehicle_model].filter(Boolean).join(" ") || "Vehicle not available";
                return `<div class="mini-ro"><div><strong>RO ${escapeHtml(row.ro_number)}</strong><br><span>${escapeHtml(vehicle)}</span></div><span>${escapeHtml(row.tag_number ? "Tag " + row.tag_number : "No tag")}</span></div>`;
            }).join("") : `<div class="empty">No unassigned open ROs.</div>`;
        }
    } catch (error) {
        console.error("Dashboard RO load failed:", error);
        const list = document.getElementById("dashboardUnassignedList");
        if (list) list.innerHTML = `<div class="empty">Could not load shop status.</div>`;
    }

    try {
        const start = new Date();
        start.setHours(0,0,0,0);
        const { count, error } = await supabaseClient
            .from("parts")
            .select("id", { count: "exact", head: true })
            .gte("received_at", start.toISOString());
        if (error) throw error;
        const el = document.getElementById("dashPartsToday");
        if (el) el.textContent = count ?? 0;
    } catch (error) {
        console.error("Dashboard parts count failed:", error);
        const el = document.getElementById("dashPartsToday");
        if (el) el.textContent = "—";
    }

    const updated = document.getElementById("dashboardLastUpdated");
    if (updated) updated.textContent = new Date().toLocaleTimeString([], {hour:"numeric",minute:"2-digit"});
}

